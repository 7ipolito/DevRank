# World ID & MiniKit Configuration
NEXT_PUBLIC_APP_ID=your_app_id_here
NEXT_PUBLIC_WLD_CLIENT_ID=your_world_client_id_here

# Contract Addresses (Worldchain Mainnet)
NEXT_PUBLIC_WLD_TOKEN_ADDRESS=0xYourWLDTokenAddressHere
NEXT_PUBLIC_COMPETITION_CONTRACT_ADDRESS=0xYourCompetitionContractAddressHere

# API Configuration
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/your-subgraph-id

# JWT Secret (Server-side only)
JWT_SECRET=your_jwt_secret_here_change_in_production

# Node Environment
NODE_ENV=development
